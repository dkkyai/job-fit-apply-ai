# jd-bridge API base URL (the backlog UI reads/writes tracks through the bridge).
# Local dev on this Mac: http://localhost:8765
# Served build (reached over Tailscale): http://<your-tailscale-name>:8765
VITE_API_BASE_URL=http://localhost:8765

# Testing Configuration
# For unit tests (Vitest)
VITE_TEST_MODE=true

# For e2e tests (Playwright)
PLAYWRIGHT_TEST_BASE_URL=http://localhost:8080

# Backlog Serve Script Configuration (used by scripts/serve-backlog.sh)
# BACKLOG_PROJECT_DIR=/path/to/your/project
# BACKLOG_LOG_DIR=/path/to/your/logs
# BACKLOG_PORT=8081
# BACKLOG_SERVE_BIN=/path/to/serve
# BACKLOG_TAILSCALE_BIN=/usr/local/bin/tailscale
