<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd agent: keep the dedicated CDP-enabled Chrome alive (watchdog).

  Runs cdp-watchdog.sh at login (RunAtLoad) and every 60s (StartInterval). The script is
  short-lived: it polls the CDP port and only (re)launches Chrome when the port is dead, so
  it recovers from a crash, a manual Cmd-Q, or a hung Chrome — within one interval.

  Install (uses the canonical checkout path in ProgramArguments below — edit if yours differs):
    cp scripts/com.jd.chrome-cdp.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.jd.chrome-cdp.plist

  Status / logs:
    launchctl print gui/$(id -u)/com.jd.chrome-cdp | grep -i state
    tail -f /tmp/jd-chrome-cdp.out.log /tmp/jd-chrome-cdp.err.log

  Uninstall:
    launchctl bootout gui/$(id -u)/com.jd.chrome-cdp
    rm ~/Library/LaunchAgents/com.jd.chrome-cdp.plist

  Note: because this polls the port and relaunches, it WILL bring Chrome back if you Cmd-Q it.
  To stop it permanently, bootout the agent (above) rather than quitting the window.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.jd.chrome-cdp</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/dkkyai/projects/job-fit-apply-ai/services/job-fit-apply-ai-pipeline/scripts/cdp-watchdog.sh</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>StartInterval</key>
    <integer>60</integer>

    <key>ProcessType</key>
    <string>Background</string>

    <key>StandardOutPath</key>
    <string>/tmp/jd-chrome-cdp.out.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/jd-chrome-cdp.err.log</string>
</dict>
</plist>
