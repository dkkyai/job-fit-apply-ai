# Notifier config. Copy to .env for local runs (compose passes these as env in prod).
JD_BRIDGE_URL=http://127.0.0.1:8765

# Messaging channels — nothing is sent when blank. Never commit real values.
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Telegram high-fit ping threshold
NOTIFICATION_FIT_THRESHOLD=50

# Persisted consumer cursor (mounted volume in the container)
NOTIFIER_CURSOR_FILE=./state/notifier-cursor.txt
