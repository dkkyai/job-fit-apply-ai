# Watchlist ingestion config. Copy to .env for local runs (compose passes these as env in prod).

JD_BRIDGE_URL=http://127.0.0.1:8765

# Minimum spacing between real polls (ms). Default 24h. Feeds are free, so this is politeness,
# not quota.
WATCHLIST_INTERVAL_MS=86400000

# Persisted last-run state and per-employer health (a mounted volume in the container).
WATCHLIST_STATE_FILE=./state/watchlist.json
WATCHLIST_HEALTH_FILE=./state/watchlist-health.json

# Employer list. Blank = the bundled src/main/resources/employers.yaml.
WATCHLIST_EMPLOYERS_FILE=

# Title pre-filter (case-insensitive regex). Only matching titles reach the bridge (and the LLM).
WATCHLIST_TITLE_INCLUDE=\b(qa|qe|sdet|quality|test|tester|testing|verification|validation)\b
WATCHLIST_TITLE_EXCLUDE=\b(intern|internship|technician|clinical|nurse|driver|warehouse|asic|fpga|rtl|soc|silicon|design verification|formal verification|microbiolog\w*|laboratory|aml)\b

# Pause between employers (ms) — keeps the daily sweep polite.
WATCHLIST_INTER_EMPLOYER_DELAY_MS=750
