# JSearch ingestion config. Copy to .env for local runs (compose passes these as env in prod).

JD_BRIDGE_URL=http://127.0.0.1:8765

# RapidAPI key for jsearch.p.rapidapi.com (required to fetch). Never commit the real value.
JSEARCH_API_KEY=

# Minimum spacing between real fetches (ms). Default 24h keeps ~120 calls/month (150/mo quota).
JSEARCH_INTERVAL_MS=86400000

# Persisted last-run state (a mounted volume in the container).
JSEARCH_STATE_FILE=./state/jsearch.json
